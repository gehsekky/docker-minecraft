# copy to .env and edit. docker compose reads .env automatically.

# must be true to accept the Minecraft EULA: https://aka.ms/MinecraftEULA
EULA=false

# comma-separated Minecraft usernames and/or UUIDs to grant admin (op).
OPS=

# everything below is optional; these are the defaults.
#MINECRAFT_VERSION=26.3
#MINECRAFT_DATA=./docker-minecraft-data
#JAVA_MEMORY=2G
#OP_LEVEL=4
#USE_AIKARS_FLAGS=true
#ALLOW_DOWNGRADE=false
