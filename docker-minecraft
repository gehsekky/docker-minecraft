#!/bin/bash
set -euo pipefail

echo "docker-minecraft - '$(id -un):$(id -gn)'"

EULA=${EULA:-false}
MINECRAFT_HOME="/opt/minecraft"
MINECRAFT_VERSION=${MINECRAFT_VERSION:-}
JAVA_MEMORY=${JAVA_MEMORY:-2G}
OPS=${OPS:-}
OP_LEVEL=${OP_LEVEL:-4}
PAPER_BUILD=${PAPER_BUILD:-}
USE_RECOMMENDED_FLAGS=${USE_RECOMMENDED_FLAGS:-true}
ALLOW_DOWNGRADE=${ALLOW_DOWNGRADE:-false}
# Fill (v3) requires a non-generic User-Agent identifying the software + a contact.
USER_AGENT=${USER_AGENT:-"docker-minecraft/1.0 (https://github.com/gehsekky/docker-minecraft)"}
PAPER_API="https://fill.papermc.io/v3/projects/paper"
TEMP_DIR="$MINECRAFT_HOME/temp"
VERSION_FILE="$MINECRAFT_HOME/.paper-version"
BUILD_FILE="$MINECRAFT_HOME/.paper-build"
FLAGS_FILE="$MINECRAFT_HOME/.paper-jvm-flags"
BACKUP_DIR="$MINECRAFT_HOME/backups"

get_paper() {
    echo "fetching paper $MINECRAFT_VERSION"
    mkdir -p "$TEMP_DIR"
    cd "$TEMP_DIR"

    local builds build url sha
    builds=$(curl -fsSL -A "$USER_AGENT" "${PAPER_API}/versions/${MINECRAFT_VERSION}/builds")

    if [ -n "$PAPER_BUILD" ]; then
        build=$(echo "$builds" | jq -c --arg id "$PAPER_BUILD" 'map(select((.id | tostring) == $id)) | first')
    else
        # newest STABLE build, falling back to the newest build overall
        # (a brand-new version may only have ALPHA/BETA builds for a while)
        build=$(echo "$builds" | jq -c 'sort_by(.id) | (map(select(.channel == "STABLE")) | last) // last')
    fi
    if [ -z "$build" ] || [ "$build" = "null" ]; then
        echo "ERROR: no Paper build found for version '$MINECRAFT_VERSION' (PAPER_BUILD='$PAPER_BUILD')" >&2
        exit 1
    fi

    BUILD_NUMBER=$(echo "$build" | jq -r '.id')
    url=$(echo "$build" | jq -r '.downloads["server:default"].url // empty')
    sha=$(echo "$build" | jq -r '.downloads["server:default"].checksums.sha256 // empty' | tr '[:upper:]' '[:lower:]')
    echo "BUILD_NUMBER=$BUILD_NUMBER"
    echo "download URL=$url"
    if [ -z "$url" ]; then
        echo "ERROR: build $BUILD_NUMBER has no 'server:default' download" >&2
        exit 1
    fi

    curl -fSL -A "$USER_AGENT" -o paper.jar "$url"

    if [ -n "$sha" ]; then
        echo "verifying checksum"
        echo "$sha  paper.jar" | sha256sum -c - \
            || { echo "ERROR: paper.jar checksum mismatch" >&2; exit 1; }
    fi

    # only after the download checks out, so a bad version can't pile up backups in a restart loop
    backup_data

    # same filesystem as the data volume, so a failed update can't leave a partial jar
    mv paper.jar "$MINECRAFT_HOME/paper.jar"
    echo "$MINECRAFT_VERSION" > "$VERSION_FILE"
    echo "$BUILD_NUMBER" > "$BUILD_FILE"
    rm -f "$FLAGS_FILE"   # may differ by version; fetched again before startup
}

# save Paper's recommended JVM flags for this version, so restarts don't need the network
fetch_jvm_flags() {
    local flags
    flags=$(curl -fsSL -A "$USER_AGENT" "${PAPER_API}/versions/${MINECRAFT_VERSION}" \
        | jq -r '.version.java.flags.recommended // [] | .[]') || return 1
    [ -n "$flags" ] || return 1
    echo "$flags" > "$FLAGS_FILE"
}

# snapshot the data volume before replacing paper.jar. keeps the old jar and version record
# so a restore is a full rollback; skips what the server can download again.
backup_data() {
    [ -f "$MINECRAFT_HOME/paper.jar" ] || return 0

    local installed="unknown" dest
    [ -f "$VERSION_FILE" ] && installed=$(cat "$VERSION_FILE")
    dest="$BACKUP_DIR/pre-${MINECRAFT_VERSION}-from-${installed}-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"

    echo "backing up to $dest"
    mkdir -p "$BACKUP_DIR"
    tar -czf "$TEMP_DIR/backup.tar.gz" -C "$MINECRAFT_HOME" \
        --exclude=./backups --exclude=./temp --exclude=./cache \
        --exclude=./libraries --exclude=./versions --exclude=./logs .
    mv "$TEMP_DIR/backup.tar.gz" "$dest"
}

# true if going from version $1 to $2 moves backwards (pre-release suffixes are ignored)
is_downgrade() {
    local from="${1%%-*}" to="${2%%-*}"
    [ "$from" != "$to" ] && [ "$(printf '%s\n%s\n' "$from" "$to" | sort -V | head -n1)" = "$to" ]
}

# true if paper.jar must be (re)downloaded; exits rather than downgrade a world
paper_needed() {
    [ -f "$MINECRAFT_HOME/paper.jar" ] || return 0
    if [ ! -f "$VERSION_FILE" ]; then
        echo "WARNING: installed paper version unknown; downloading $MINECRAFT_VERSION" >&2
        return 0
    fi

    local installed installed_build=""
    installed=$(cat "$VERSION_FILE")
    [ -f "$BUILD_FILE" ] && installed_build=$(cat "$BUILD_FILE")
    if [ "$installed" = "$MINECRAFT_VERSION" ]; then
        if [ -z "$PAPER_BUILD" ] || [ "$installed_build" = "$PAPER_BUILD" ]; then
            return 1
        fi
        echo "changing paper build from ${installed_build:-unknown} to $PAPER_BUILD"
        return 0
    fi

    if is_downgrade "$installed" "$MINECRAFT_VERSION" && [ "$ALLOW_DOWNGRADE" != "true" ]; then
        echo "ERROR: refusing to downgrade from $installed to $MINECRAFT_VERSION; this can damage the world." >&2
        echo "back up the data volume and set ALLOW_DOWNGRADE=true to override." >&2
        exit 1
    fi
    echo "changing paper version from $installed to $MINECRAFT_VERSION"
}

write_eula() {
    echo 'writing eula'
    echo "eula=$EULA" > "$MINECRAFT_HOME/eula.txt"
}

# true if $1 is a 32-hex-char UUID (with or without dashes)
is_uuid() {
    local s="${1//-/}"
    [[ "$s" =~ ^[0-9a-fA-F]{32}$ ]]
}

# normalize a (possibly dashless) UUID to lowercase 8-4-4-4-12 form
dash_uuid() {
    local s
    s="$(echo "${1//-/}" | tr '[:upper:]' '[:lower:]')"
    echo "${s:0:8}-${s:8:4}-${s:12:4}-${s:16:4}-${s:20:12}"
}

# resolve a Minecraft username to "<dashed-uuid> <canonical-name>" via Mojang, or fail
resolve_uuid() {
    local resp id name
    resp=$(curl -fsSL "https://api.mojang.com/users/profiles/minecraft/$1") || return 1
    id=$(echo "$resp" | jq -r '.id // empty')
    name=$(echo "$resp" | jq -r '.name // empty')
    [ -n "$id" ] || return 1
    echo "$(dash_uuid "$id") $name"
}

# update ops.json from the OPS env var (comma-separated usernames and/or UUIDs).
# $MANAGED_OPS_FILE records which UUIDs came from OPS, so removing someone from OPS
# deops them while admins added in-game with /op are left alone.
write_ops() {
    local ops_file="$MINECRAFT_HOME/ops.json"
    local managed_file="$MINECRAFT_HOME/.ops-managed"
    if [ -z "$OPS" ] && [ ! -f "$managed_file" ]; then
        echo "no OPS set; skipping op configuration"
        return 0
    fi
    echo "updating ops.json from OPS='$OPS' (level $OP_LEVEL)"

    local existing="[]" previous="[]" managed="[]" entries raw entry uuid name resolved
    [ -s "$ops_file" ] && existing=$(cat "$ops_file")
    [ -s "$managed_file" ] && previous=$(cat "$managed_file")
    entries=$(echo "$existing" | jq --argjson previous "$previous" \
        'map(select(.uuid as $uuid | $previous | index($uuid) | not))')

    local items=()
    IFS=',' read -ra items <<< "$OPS"
    for raw in "${items[@]}"; do
        entry="$(echo "$raw" | xargs)"   # trim whitespace
        [ -z "$entry" ] && continue
        if is_uuid "$entry"; then
            uuid="$(dash_uuid "$entry")"
            name=""
        elif resolved=$(resolve_uuid "$entry"); then
            uuid="${resolved%% *}"
            name="${resolved#* }"
        else
            # e.g. Mojang is down: don't lock out an admin we already know about
            uuid=$(echo "$existing" | jq -r --arg name "$entry" \
                'map(select((.name // "" | ascii_downcase) == ($name | ascii_downcase))) | first | .uuid // empty')
            name="$entry"
            if [ -z "$uuid" ]; then
                echo "  WARNING: could not resolve '$entry' to a UUID; skipping" >&2
                continue
            fi
            echo "  WARNING: could not resolve '$entry'; keeping existing op entry" >&2
        fi
        echo "  op: ${name:-$uuid} ($uuid) level $OP_LEVEL"
        entries=$(echo "$entries" | jq \
            --arg uuid "$uuid" --arg name "$name" --argjson level "$OP_LEVEL" \
            'map(select(.uuid != $uuid)) + [{uuid:$uuid, name:$name, level:$level, bypassesPlayerLimit:false}]')
        managed=$(echo "$managed" | jq --arg uuid "$uuid" '. + [$uuid]')
    done

    echo "$entries" > "$ops_file"
    echo "$managed" > "$managed_file"
}

cleanup() {
    echo 'cleaning up'
    rm -rf "$TEMP_DIR"
}

echo 'executing script'

if [ "$EULA" != "true" ]; then
    echo "ERROR: set EULA=true to accept the Minecraft EULA: https://aka.ms/MinecraftEULA" >&2
    exit 1
fi
if [ -z "$MINECRAFT_VERSION" ]; then
    echo "ERROR: MINECRAFT_VERSION is not set" >&2
    exit 1
fi

if [ ! -f "$MINECRAFT_HOME/server.properties" ]; then
    cp /server.properties "$MINECRAFT_HOME"
fi

if paper_needed; then
    get_paper
    cleanup
fi

write_eula
write_ops   # runs every start, so editing OPS + restart updates admins

JVM_OPTS=(-Xms"${JAVA_MEMORY}" -Xmx"${JAVA_MEMORY}")
if [ "$USE_RECOMMENDED_FLAGS" = "true" ]; then
    # the server runs fine without these, so don't let an API outage stop it starting
    if [ -s "$FLAGS_FILE" ] || fetch_jvm_flags; then
        readarray -t RECOMMENDED_FLAGS < "$FLAGS_FILE"
        JVM_OPTS+=("${RECOMMENDED_FLAGS[@]}")
    else
        echo "WARNING: could not fetch Paper's recommended JVM flags; starting without them" >&2
    fi
fi

echo "starting up paper server"
cd "$MINECRAFT_HOME"
# exec so java becomes PID 1 and receives SIGTERM from `docker stop` for a clean world save
exec java "${JVM_OPTS[@]}" -jar "$MINECRAFT_HOME/paper.jar" --nogui
